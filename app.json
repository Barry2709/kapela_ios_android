{
  "expo": {
    "name": "Kapela",
    "slug": "kapela_ios_android",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a86f8275-679e-4dac-88ba-219ed454b5de"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kapelaiosandroid",
    "userInterfaceStyle": "automatic",
    "ios": {
      "deploymentTarget": "16.0",
      "bundleIdentifier": "com.ios.kapela",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCalendarsUsageDescription": "Aplikace potřebuje přístup ke kalendáři pro synchronizaci kapelních zkoušek a koncertů s vaším zařízením."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.ios.kapela"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ios.kapela",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Aplikace potřebuje přístup k mikrofonu pro nahrávání zvuku ze zkoušek."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "newArchEnabled": false
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#e91e63"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Aplikace potřebuje přístup ke kalendáři pro přidávání a zobrazení zkoušek a koncertů."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-mail-composer",
      "expo-sharing",
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ConcertWidget",
              "label": "Kapela - Příští Koncert (Karta)",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "Zobrazuje název a datum nejbližšího koncertu kapely ve formě karty.",
              "updatePeriodMillis": 3600000,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "500dp",
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "ConcertWidget3x1",
              "label": "Kapela - Příští Koncert (3x1)",
              "minWidth": "180dp",
              "minHeight": "60dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "description": "Kompaktní widget 3x1 s datem a názvem koncertu.",
              "updatePeriodMillis": 3600000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "ConcertWidget4x1",
              "label": "Kapela - Příští Koncert (4x1)",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "description": "Široký widget 4x1 přes celou šířku obrazovky.",
              "updatePeriodMillis": 3600000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "ConcertWidget5x1",
              "label": "Kapela - Příští Koncert (5x1)",
              "minWidth": "320dp",
              "minHeight": "60dp",
              "targetCellWidth": 5,
              "targetCellHeight": 1,
              "description": "Extra široký widget 5x1 pro velké displeje.",
              "updatePeriodMillis": 3600000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a86f8275-679e-4dac-88ba-219ed454b5de"
      }
    }
  }
}